# Copy this file to .env and replace the example values.
# Use URL-safe (for example, hexadecimal) MongoDB passwords because the
# Compose file embeds the app credentials in a MongoDB connection URI.
MONGO_ROOT_USER=ichat_root
MONGO_ROOT_PASSWORD=replace_with_a_long_hex_secret
MONGO_APP_USER=ichat_app
MONGO_APP_PASSWORD=replace_with_a_long_hex_secret

# Generate a strong value, for example: openssl rand -hex 32
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:4200
COOKIE_SECURE=false

LLM_API_KEY=replace_with_your_provider_api_key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=replace_with_your_model_name
# Optional
LLM_FALLBACK_MODEL=
